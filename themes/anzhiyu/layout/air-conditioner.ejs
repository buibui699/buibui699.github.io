<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.title || site.data['air-conditioner'].title %> | <%= config.title %></title>
    <meta name="description" content="<%= site.data['air-conditioner'].description %>">
    
    <!-- 引入主题的基础CSS -->
    <%- css('css/style') %>
    
    <style>
        /* 小空调专用样式 */
        .air-conditioner-page {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, <%= site.data['air-conditioner'].theme.primary_color %> 0%, <%= site.data['air-conditioner'].theme.secondary_color %> 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            color: #333;
        }

        .ac-header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

        .ac-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .ac-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 500px;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .ac-title {
            font-size: 1.8rem;
            margin-bottom: 20px;
            color: #333;
        }

        .tip {
            color: #ff9500;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        .tip a {
            color: <%= site.data['air-conditioner'].theme.primary_color %>;
            text-decoration: none;
        }

        .ac-display {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 30px 0;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 15px;
        }

        .ac-icon {
            width: 80px;
            height: 80px;
            background: <%= site.data['air-conditioner'].theme.primary_color %>;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .ac-icon::before {
            content: '❄️';
            font-size: 2rem;
            animation: none;
        }

        .ac-icon.cooling::before {
            animation: pulse 1s infinite;
        }

        .ac-icon.heating::before {
            content: '🔥';
            animation: pulse 1s infinite;
        }

        .temperature-display {
            font-size: 3rem;
            font-weight: bold;
            color: #333;
            display: flex;
            align-items: baseline;
        }

        .temp-unit {
            font-size: 1.5rem;
            margin-left: 5px;
            color: #666;
        }

        .controls {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 30px 0;
        }

        .control-btn {
            width: 60px;
            height: 60px;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .control-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

        .control-btn:active {
            transform: scale(0.95);
        }

        .cooling-btn {
            background: <%= site.data['air-conditioner'].theme.primary_color %>;
            color: white;
        }

        .power-btn {
            background: <%= site.data['air-conditioner'].theme.success_color %>;
            color: white;
        }

        .heating-btn {
            background: <%= site.data['air-conditioner'].theme.warning_color %>;
            color: white;
        }

        .temp-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
        }

        .temp-btn {
            width: 50px;
            height: 50px;
            border: none;
            border-radius: 50%;
            background: #ddd;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .temp-btn:hover {
            background: #bbb;
            transform: scale(1.1);
        }

        .ac-footer {
            margin-top: 40px;
            text-align: center;
            color: white;
            opacity: 0.8;
            font-size: 0.9rem;
        }

        .status-indicator {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #ddd;
            transition: all 0.3s ease;
        }

        .status-indicator.on {
            background: <%= site.data['air-conditioner'].theme.success_color %>;
            box-shadow: 0 0 10px rgba(0, 184, 148, 0.5);
        }

        .wind-effect {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .wind-effect.active {
            opacity: 1;
        }

        .wind-line {
            position: absolute;
            height: 2px;
            background: rgba(116, 185, 255, 0.3);
            animation: wind 2s infinite linear;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        @keyframes wind {
            0% { transform: translateX(-100px); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateX(100px); opacity: 0; }
        }

        .mode-text {
            margin-top: 15px;
            font-size: 1rem;
            color: #666;
            font-weight: 500;
        }

        @media (max-width: 600px) {
            .ac-header h1 {
                font-size: 2rem;
            }
            
            .ac-container {
                padding: 30px 20px;
            }
            
            .ac-display {
                flex-direction: column;
                gap: 20px;
            }
            
            .controls {
                flex-wrap: wrap;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="air-conditioner-page">
        <div class="ac-header">
            <h1><%= site.data['air-conditioner'].title %></h1>
        </div>

        <div class="ac-container">
            <div class="status-indicator" id="statusIndicator"></div>
            
            <div class="wind-effect" id="windEffect">
                <div class="wind-line" style="top: 20%; animation-delay: 0s;"></div>
                <div class="wind-line" style="top: 40%; animation-delay: 0.5s;"></div>
                <div class="wind-line" style="top: 60%; animation-delay: 1s;"></div>
                <div class="wind-line" style="top: 80%; animation-delay: 1.5s;"></div>
            </div>

            <h2 class="ac-title"><%= site.data['air-conditioner'].text.title %></h2>
            
            <div class="tip">
                <%= site.data['air-conditioner'].text.tip %>
            </div>

            <div class="ac-display">
                <div class="ac-icon" id="acIcon"></div>
                <div class="temperature-display">
                    <span id="temperature"><%= site.data['air-conditioner'].default_temperature %></span>
                    <span class="temp-unit">°C</span>
                </div>
            </div>

            <div class="controls">
                <button class="control-btn cooling-btn" id="coolingBtn" title="<%= site.data['air-conditioner'].text.buttons.cooling %>">❄️</button>
                <button class="control-btn power-btn" id="powerBtn" title="<%= site.data['air-conditioner'].text.buttons.power %>">⏻</button>
                <button class="control-btn heating-btn" id="heatingBtn" title="<%= site.data['air-conditioner'].text.buttons.heating %>">🔥</button>
            </div>

            <div class="temp-controls">
                <button class="temp-btn" id="tempUp" title="<%= site.data['air-conditioner'].text.buttons.temp_up %>">▲</button>
                <button class="temp-btn" id="tempDown" title="<%= site.data['air-conditioner'].text.buttons.temp_down %>">▼</button>
            </div>

            <div class="mode-text" id="modeText"><%= site.data['air-conditioner'].text.status.off %></div>
        </div>

        <div class="ac-footer">
            <p><%= site.data['air-conditioner'].footer.copyright %></p>
        </div>
    </div>

    <script>
        // 从配置文件获取设置
        const AC_CONFIG = {
            defaultTemp: <%= site.data['air-conditioner'].default_temperature %>,
            minTemp: <%= site.data['air-conditioner'].min_temperature %>,
            maxTemp: <%= site.data['air-conditioner'].max_temperature %>,
            audioEnabled: <%= site.data['air-conditioner'].audio.enabled %>,
            clickVolume: <%= site.data['air-conditioner'].audio.click_volume %>,
            fanVolume: <%= site.data['air-conditioner'].audio.fan_volume %>,
            statusText: {
                off: '<%= site.data["air-conditioner"].text.status.off %>',
                cooling: '<%= site.data["air-conditioner"].text.status.cooling %>',
                heating: '<%= site.data["air-conditioner"].text.status.heating %>'
            }
        };

        class AirConditioner {
            constructor() {
                this.isOn = false;
                this.mode = 'off';
                this.temperature = AC_CONFIG.defaultTemp;
                this.targetTemp = 26;
                this.audioInitialized = false;
                
                this.initElements();
                this.bindEvents();
                this.updateDisplay();
                this.initAudio();
            }

            initElements() {
                this.powerBtn = document.getElementById('powerBtn');
                this.coolingBtn = document.getElementById('coolingBtn');
                this.heatingBtn = document.getElementById('heatingBtn');
                this.tempUp = document.getElementById('tempUp');
                this.tempDown = document.getElementById('tempDown');
                this.temperatureDisplay = document.getElementById('temperature');
                this.acIcon = document.getElementById('acIcon');
                this.modeText = document.getElementById('modeText');
                this.statusIndicator = document.getElementById('statusIndicator');
                this.windEffect = document.getElementById('windEffect');
            }

            bindEvents() {
                this.powerBtn.addEventListener('click', () => this.togglePower());
                this.coolingBtn.addEventListener('click', () => this.setMode('cooling'));
                this.heatingBtn.addEventListener('click', () => this.setMode('heating'));
                this.tempUp.addEventListener('click', () => this.adjustTemperature(1));
                this.tempDown.addEventListener('click', () => this.adjustTemperature(-1));
            }

            togglePower() {
                this.isOn = !this.isOn;
                
                if (!this.isOn) {
                    this.mode = 'off';
                    clearInterval(this.tempInterval);
                    this.playSound('click');
                } else {
                    this.mode = 'cooling';
                    this.startTemperatureControl();
                    this.playSound('fan');
                }
                
                this.updateDisplay();
            }

            setMode(newMode) {
                if (!this.isOn) return;
                
                this.mode = newMode;
                this.updateDisplay();
                this.playSound('click');
            }

            adjustTemperature(delta) {
                if (!this.isOn) return;
                
                this.targetTemp = Math.max(AC_CONFIG.minTemp, Math.min(AC_CONFIG.maxTemp, this.targetTemp + delta));
                this.temperature = this.targetTemp;
                this.updateDisplay();
                this.playSound('click');
            }

            startTemperatureControl() {
                this.tempInterval = setInterval(() => {
                    if (!this.isOn) return;
                    
                    if (this.mode === 'cooling' && this.temperature > this.targetTemp) {
                        this.temperature = Math.max(this.targetTemp, this.temperature - 0.5);
                    } else if (this.mode === 'heating' && this.temperature < this.targetTemp) {
                        this.temperature = Math.min(this.targetTemp, this.temperature + 0.5);
                    }
                    
                    this.updateDisplay();
                }, 2000);
            }

            updateDisplay() {
                this.temperatureDisplay.textContent = Math.round(this.temperature);
                
                this.acIcon.className = 'ac-icon';
                if (this.isOn) {
                    this.acIcon.classList.add(this.mode);
                }
                
                this.statusIndicator.classList.toggle('on', this.isOn);
                this.windEffect.classList.toggle('active', this.isOn);
                
                let modeText = AC_CONFIG.statusText.off;
                if (this.isOn) {
                    modeText = `${AC_CONFIG.statusText[this.mode]} - 目标温度 ${this.targetTemp}°C`;
                }
                this.modeText.textContent = modeText;
                
                this.coolingBtn.style.opacity = (this.mode === 'cooling' && this.isOn) ? '1' : '0.7';
                this.heatingBtn.style.opacity = (this.mode === 'heating' && this.isOn) ? '1' : '0.7';
                this.powerBtn.style.opacity = this.isOn ? '1' : '0.7';
            }

            playSound(type = 'click') {
                if (!AC_CONFIG.audioEnabled) return;
                
                try {
                    if (!this.audioInitialized) {
                        this.initAudio();
                    }
                    
                    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    
                    if (audioContext.state === 'suspended') {
                        audioContext.resume();
                    }
                    
                    if (type === 'fan') {
                        this.playFanSound(audioContext);
                    } else {
                        this.playClickSound(audioContext);
                    }
                } catch (e) {
                    console.log('音频播放失败:', e);
                }
            }

            playClickSound(audioContext) {
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.setValueAtTime(1000, audioContext.currentTime);
                gainNode.gain.setValueAtTime(AC_CONFIG.clickVolume, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.2);
            }

            playFanSound(audioContext) {
                const bufferSize = audioContext.sampleRate * 3;
                const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
                const data = buffer.getChannelData(0);

                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * 0.4;
                }

                const source = audioContext.createBufferSource();
                const gainNode = audioContext.createGain();
                const filter = audioContext.createBiquadFilter();

                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, audioContext.currentTime);

                source.buffer = buffer;
                source.connect(filter);
                filter.connect(gainNode);
                gainNode.connect(audioContext.destination);

                gainNode.gain.setValueAtTime(0, audioContext.currentTime);
                gainNode.gain.linearRampToValueAtTime(AC_CONFIG.fanVolume, audioContext.currentTime + 0.3);
                gainNode.gain.linearRampToValueAtTime(AC_CONFIG.fanVolume * 0.8, audioContext.currentTime + 2.5);
                gainNode.gain.linearRampToValueAtTime(0, audioContext.currentTime + 3);

                source.start(audioContext.currentTime);
                source.stop(audioContext.currentTime + 3);

                const beepOsc = audioContext.createOscillator();
                const beepGain = audioContext.createGain();
                
                beepOsc.connect(beepGain);
                beepGain.connect(audioContext.destination);
                
                beepOsc.frequency.setValueAtTime(400, audioContext.currentTime);
                beepGain.gain.setValueAtTime(0, audioContext.currentTime);
                beepGain.gain.linearRampToValueAtTime(0.1, audioContext.currentTime + 0.1);
                beepGain.gain.linearRampToValueAtTime(0.05, audioContext.currentTime + 0.5);
                beepGain.gain.linearRampToValueAtTime(0, audioContext.currentTime + 1);
                
                beepOsc.start(audioContext.currentTime);
                beepOsc.stop(audioContext.currentTime + 1);
            }

            initAudio() {
                document.addEventListener('click', () => {
                    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    if (audioContext.state === 'suspended') {
                        audioContext.resume();
                    }
                    this.audioInitialized = true;
                }, { once: true });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            new AirConditioner();
        });

        // 3D悬浮效果
        document.addEventListener('mousemove', (e) => {
            const container = document.querySelector('.ac-container');
            const rect = container.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const deltaX = (x - centerX) / centerX;
            const deltaY = (y - centerY) / centerY;
            
            container.style.transform = `perspective(1000px) rotateY(${deltaX * 5}deg) rotateX(${-deltaY * 5}deg)`;
        });

        document.querySelector('.ac-container').addEventListener('mouseleave', () => {
            document.querySelector('.ac-container').style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
        });
    </script>
</body>
</html>